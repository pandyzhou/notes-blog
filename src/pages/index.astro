---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostItem from "../components/PostItem.astro";
import { getPublishedPosts, SITE } from "../lib/notion";

const all = await getPublishedPosts();
const posts = [...all].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <h1>{SITE.title}</h1>
      <p>{SITE.description}</p>
    </div>
  </section>

  <div class="wrap">
    {
      posts.length === 0 ? (
        <div class="empty">
          <p>还没有已发布的文章。</p>
          <p>
            在 Notion 的文章数据库里新建一条，把「状态」设为
            <code>已发布</code>，重新构建即可。
          </p>
        </div>
      ) : (
        <ul class="post-list">
          {posts.map((post) => <PostItem post={post} />)}
        </ul>
      )
    }
  </div>
</BaseLayout>
