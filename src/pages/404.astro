---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在">
  <section class="hero">
    <div class="wrap">
      <h1>404</h1>
      <p>这个页面不存在，或者已经被移走了。</p>
    </div>
  </section>
  <div class="wrap">
    <div class="empty">
      <a class="back-link" href="/">← 返回首页</a>
    </div>
  </div>
</BaseLayout>
