---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostItem from "../../components/PostItem.astro";
import { getPublishedPosts, tagSlug, type Post } from "../../lib/notion";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const groups = new Map<string, { name: string; posts: Post[] }>();

  for (const post of posts) {
    for (const tag of post.tags) {
      const slug = tagSlug(tag);
      if (!slug) continue;
      if (!groups.has(slug)) groups.set(slug, { name: tag, posts: [] });
      groups.get(slug)!.posts.push(post);
    }
  }

  return [...groups.entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: { tagName: group.name, posts: group.posts },
  }));
}

interface Props {
  tagName: string;
  posts: Post[];
}
const { tagName, posts } = Astro.props;
---

<BaseLayout
  title={`标签：${tagName}`}
  description={`关于 ${tagName} 的全部文章`}
>
  <section class="hero">
    <div class="wrap">
      <h1>{tagName}</h1>
      <p>共 {posts.length} 篇文章。</p>
    </div>
  </section>

  <div class="wrap">
    <ul class="post-list">
      {posts.map((post) => <PostItem post={post} />)}
    </ul>
    <div class="article-foot">
      <a class="back-link" href="/tags/">← 全部标签</a>
    </div>
  </div>
</BaseLayout>
